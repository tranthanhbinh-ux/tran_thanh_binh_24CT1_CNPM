{#
/**
 * @file
 * BuildGear - Product Detail Template (Node: Linh Kiện PC)
 *
 * Theme: buildgear (Drupal 10)
 * Dark Gaming Theme (bg-surface-900, text-white, text-neon-blue)
 */
#}

<style>
  /* Ép ảnh từ Drupal render vừa vặn khung hiển thị */
  .product-image-container img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: contain;
    border-radius: 12px;
  }
  
  /* Style sọc vằn cho các trường thông số Drupal tự render ở nửa dưới */
  .detail-specs-table .field {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .detail-specs-table .field:nth-child(odd) {
    background-color: #12121a; /* bg-surface-800 */
  }
  .detail-specs-table .field:nth-child(even) {
    background-color: #0a0a0f; /* bg-surface-900 */
  }
  .detail-specs-table .field__label {
    font-weight: 600;
    color: #9ca3af;
    font-size: 0.875rem;
  }
  .detail-specs-table .field__item {
    color: #f3f4f6;
    font-weight: 500;
    font-size: 0.875rem;
  }
</style>

<article class="w-full max-w-7xl mx-auto px-4 py-8">
  
  <!-- 1. MAIN GRID (2 CỘT PHẦN TRÊN) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start mb-16">
    
    <!-- CỘT TRÁI: Ảnh sản phẩm -->
    <div class="bg-surface-800 border border-white/5 rounded-2xl p-6 sm:p-10 flex items-center justify-center relative overflow-hidden group shadow-2xl">
      <!-- Glow effect nền sau ảnh -->
      <div class="absolute inset-0 bg-neon-blue/10 blur-3xl rounded-full scale-50 group-hover:scale-125 transition-transform duration-700 pointer-events-none"></div>
      
      <div class="product-image-container relative z-10 w-full flex items-center justify-center drop-shadow-2xl transition-transform duration-500 group-hover:scale-105">
        {{ content.field_hinh_anh_san_pham }}
      </div>
    </div>

    <!-- CỘT PHẢI: Thông tin & Mua hàng -->
    <div class="flex flex-col">
      
      <!-- Tên sản phẩm -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white leading-tight mb-4 tracking-tight">
        {{ label }}
      </h1>

      <!-- Điểm Benchmark (Tia sét ⚡) -->
      {% if content.field_benchmark %}
      <div class="mb-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-neon-blue/10 border border-neon-blue/30 text-neon-blue font-bold text-sm shadow-[0_0_15px_rgba(0,180,255,0.15)]">
          <span>⚡ Điểm Benchmark:</span>
          <span>{{ content.field_benchmark }}</span>
        </div>
      </div>
      {% endif %}

      <!-- Giá bán -->
      <div class="text-3xl sm:text-4xl font-black text-neon-blue mb-6 tracking-tight">
        {{ content.field_gia_ban }}
      </div>

      <!-- Khối Thông số cơ bản (UI tĩnh) -->
      <div class="bg-surface-800/50 rounded-xl p-5 border border-white/5 text-sm text-gray-400 space-y-2.5 mb-6">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Thông số cơ bản</h3>
        <div class="flex justify-between border-b border-white/5 pb-2">
          <span>Bảo hành chính hãng</span>
          <span class="text-gray-200 font-medium">36 Tháng</span>
        </div>
        <div class="flex justify-between border-b border-white/5 pb-2">
          <span>Tình trạng hàng</span>
          <span class="text-emerald-400 font-semibold">● Còn hàng</span>
        </div>
        <div class="flex justify-between border-b border-white/5 pb-2">
          <span>Giao hàng</span>
          <span class="text-gray-200 font-medium">Toàn quốc (Freeship > 10Tr)</span>
        </div>
        <div class="flex justify-between">
          <span>Hỗ trợ kỹ thuật</span>
          <span class="text-gray-200 font-medium">24/7 Miễn phí lắp đặt</span>
        </div>
      </div>

      <!-- Nút Thêm Vào Giỏ -->
      <button id="addToCartBtn" onclick="addToCart()" type="button" class="w-full py-4 bg-neon-blue text-white font-bold text-base uppercase rounded-xl hover:shadow-[0_0_30px_rgba(0,180,255,0.45)] transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer flex items-center justify-center gap-2 shadow-lg">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
        </svg>
        <span>THÊM VÀO GIỎ HÀNG</span>
      </button>

    </div>

  </div>

  <!-- 2. PHẦN THÔNG SỐ KỸ THUẬT CHI TIẾT (NỬA DƯỚI) -->
  <div class="bg-surface-800 border border-white/5 rounded-2xl p-6 sm:p-8 shadow-2xl">
    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/5">
      <div class="w-8 h-8 rounded-lg bg-neon-blue/10 flex items-center justify-center text-neon-blue">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
        Thông Số Kỹ Thuật Chi Tiết
      </h2>
    </div>

    <!-- Bảng thông số chi tiết sọc vằn (Hiển thị các trường còn lại của Drupal) -->
    <div class="detail-specs-table rounded-xl overflow-hidden border border-white/5">
      {{ content|without('field_hinh_anh_san_pham', 'field_gia_ban', 'field_benchmark') }}
    </div>
  </div>

</article>