{#
/**
 * @file
 * BuildGear - Custom Login Page Template
 *
 * Template: page--user--login.html.twig
 * Theme: buildgear (Drupal 10)
 *
 * QUAN TRỌNG:
 * - File này CHỈ thay đổi giao diện trang đăng nhập.
 * - Toàn bộ logic authentication do Drupal xử lý.
 * - Form đăng nhập được render qua {{ page.content }}.
 * - Không tự tạo input, không viết PHP, không hard-code credentials.
 * - CSRF token và hidden fields của Drupal được giữ nguyên.
 *
 * URL: /user/login
 */
#}

<!DOCTYPE html>
<html{{ html_attributes }}>
<head>
  <head-placeholder token="{{ placeholder_token }}">
  <title>{{ head_title|safe_join(' | ') }}</title>
  <css-placeholder token="{{ placeholder_token }}">
  <js-placeholder token="{{ placeholder_token }}">

  {# ── Google Fonts ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    /* ═══════════════════════════════════════════════════════════
       BuildGear Login — Dark Gaming Theme
       Inline CSS cho mục đích test nhanh.
       Sau khi ổn định, nên tách ra file css/login.css
       ═══════════════════════════════════════════════════════════ */

    /* ── Reset & Base ── */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body.buildgear-login {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background-color: #080b12;
      color: #c8ccd4;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      transition: color .2s;
    }

    /* ── Background Effects ── */
    .bg-effects {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .bg-effects::before {
      content: '';
      position: absolute;
      top: -20%;
      left: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(0, 180, 255, .07) 0%, transparent 70%);
      border-radius: 50%;
      animation: float-orb 8s ease-in-out infinite;
    }

    .bg-effects::after {
      content: '';
      position: absolute;
      bottom: -10%;
      right: -5%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(0, 229, 255, .05) 0%, transparent 70%);
      border-radius: 50%;
      animation: float-orb 10s ease-in-out infinite reverse;
    }

    @keyframes float-orb {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(30px, -20px); }
    }

    /* Grid pattern */
    .bg-grid {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: .03;
      background-image:
        linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px);
      background-size: 50px 50px;
    }

    /* ── Header ── */
    .login-header {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 32px;
      border-bottom: 1px solid rgba(255,255,255,.05);
      background: rgba(8, 11, 18, .8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #00b4ff, #00e5ff);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(0, 180, 255, .3);
    }

    .logo-icon svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: #fff;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .logo-text {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -.02em;
    }

    .logo-text .white { color: #ffffff; }
    .logo-text .cyan { color: #00e5ff; }

    .back-link {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #6b7280;
      font-size: .85rem;
      font-weight: 500;
    }

    .back-link:hover {
      color: #00e5ff;
    }

    .back-link svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    /* ── Main Content ── */
    .login-main {
      position: relative;
      z-index: 10;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .login-wrapper {
      width: 100%;
      max-width: 440px;
    }

    /* ── Icon trên card ── */
    .card-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 24px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(0, 180, 255, .12), rgba(0, 229, 255, .08));
      border: 1px solid rgba(0, 180, 255, .2);
      display: flex;
      align-items: center;
      justify-content: center;
      animation: pulse-glow 3s ease-in-out infinite;
    }

    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 15px rgba(0, 180, 255, .15); }
      50% { box-shadow: 0 0 30px rgba(0, 180, 255, .3); }
    }

    .card-icon svg {
      width: 32px;
      height: 32px;
      stroke: #00e5ff;
      fill: none;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ── Title ── */
    .login-title {
      text-align: center;
      margin-bottom: 6px;
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: .05em;
      color: #ffffff;
    }

    .login-title .accent {
      background: linear-gradient(135deg, #00b4ff, #00e5ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .login-subtitle {
      text-align: center;
      margin-bottom: 32px;
      font-size: .85rem;
      color: #6b7280;
      line-height: 1.5;
    }

    /* ── Login Card ── */
    .login-card {
      background: #11151f;
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 20px;
      padding: 40px 36px;
      box-shadow:
        0 4px 40px rgba(0,0,0,.4),
        0 0 80px rgba(0, 180, 255, .03);
    }

    /* ── Drupal Messages ── */
    .login-messages .messages {
      margin-bottom: 20px;
      padding: 14px 18px;
      border-radius: 12px;
      font-size: .85rem;
      line-height: 1.5;
      border: 1px solid;
    }

    .login-messages .messages--error {
      background: rgba(255, 60, 95, .08);
      border-color: rgba(255, 60, 95, .25);
      color: #ff6b8a;
    }

    .login-messages .messages--status {
      background: rgba(0, 229, 255, .08);
      border-color: rgba(0, 229, 255, .25);
      color: #00e5ff;
    }

    .login-messages .messages--warning {
      background: rgba(251, 191, 36, .08);
      border-color: rgba(251, 191, 36, .25);
      color: #fbbf24;
    }

    .login-messages .messages h2 {
      font-size: .8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      margin-bottom: 6px;
    }

    .login-messages .messages a {
      color: inherit;
      text-decoration: underline;
    }

    /* ── Drupal Form Styling ── */

    /* Form item wrapper */
    .login-card .form-item {
      margin-bottom: 20px;
    }

    /* Labels */
    .login-card .form-item label,
    .login-card label {
      display: block;
      font-size: .8rem;
      font-weight: 600;
      color: #9ca3af;
      margin-bottom: 8px;
      letter-spacing: .03em;
      text-transform: uppercase;
    }

    /* Text inputs */
    .login-card input[type="text"],
    .login-card input[type="password"],
    .login-card input[type="email"] {
      width: 100%;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.03);
      color: #e5e7eb;
      font-family: 'Inter', sans-serif;
      font-size: .9rem;
      outline: none;
      transition: border-color .25s, box-shadow .25s, background .25s;
    }

    .login-card input[type="text"]:focus,
    .login-card input[type="password"]:focus,
    .login-card input[type="email"]:focus {
      border-color: rgba(0, 180, 255, .5);
      box-shadow: 0 0 0 3px rgba(0, 180, 255, .1), 0 0 20px rgba(0, 180, 255, .08);
      background: rgba(0, 180, 255, .03);
    }

    .login-card input[type="text"]::placeholder,
    .login-card input[type="password"]::placeholder,
    .login-card input[type="email"]::placeholder {
      color: #4b5563;
    }

    /* Description text */
    .login-card .form-item .description,
    .login-card .form-item--error-message {
      font-size: .75rem;
      color: #6b7280;
      margin-top: 6px;
      line-height: 1.4;
    }

    .login-card .form-item--error-message {
      color: #ff6b8a;
    }

    /* Submit button */
    .login-card input[type="submit"],
    .login-card button[type="submit"],
    .login-card .form-submit {
      width: 100%;
      padding: 14px 24px;
      margin-top: 8px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #00b4ff, #0090dd);
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      font-size: .9rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: transform .2s, box-shadow .3s;
      box-shadow: 0 0 20px rgba(0, 180, 255, .25);
    }

    .login-card input[type="submit"]:hover,
    .login-card button[type="submit"]:hover,
    .login-card .form-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 35px rgba(0, 180, 255, .45), 0 4px 20px rgba(0,0,0,.3);
    }

    .login-card input[type="submit"]:active,
    .login-card button[type="submit"]:active,
    .login-card .form-submit:active {
      transform: translateY(0);
    }

    /* Checkboxes (Remember me) */
    .login-card input[type="checkbox"] {
      accent-color: #00b4ff;
      width: 16px;
      height: 16px;
      margin-right: 8px;
      vertical-align: middle;
    }

    /* Hide Drupal default page title since we use custom title */
    .login-card .page-title,
    .login-card h1.page-title,
    .login-card .tabs,
    .login-card ul.tabs,
    .login-card ul.primary,
    .login-card .block-local-tasks-block,
    .login-card nav.tabs {
      display: none !important;
    }

    /* ── Extra Links ── */
    .login-extra-links {
      margin-top: 24px;
      text-align: center;
    }

    .login-extra-links a {
      display: inline-block;
      font-size: .82rem;
      font-weight: 500;
      color: #6b7280;
      transition: color .2s;
    }

    .login-extra-links a:hover {
      color: #00e5ff;
    }

    .login-extra-links .separator {
      display: block;
      height: 1px;
      background: rgba(255,255,255,.05);
      margin: 16px auto;
      width: 80px;
    }

    .login-extra-links .register-link {
      color: #00b4ff;
      font-weight: 600;
    }

    .login-extra-links .register-link:hover {
      color: #00e5ff;
    }

    /* ── Footer ── */
    .login-footer {
      position: relative;
      z-index: 10;
      text-align: center;
      padding: 20px;
      font-size: .75rem;
      color: #374151;
      border-top: 1px solid rgba(255,255,255,.03);
    }

    /* ── Decorative shapes ── */
    .deco-shape {
      position: fixed;
      border: 1px solid rgba(0, 180, 255, .1);
      border-radius: 12px;
      pointer-events: none;
      z-index: 1;
      animation: deco-float 6s ease-in-out infinite;
    }

    .deco-shape-1 {
      width: 60px;
      height: 60px;
      top: 15%;
      right: 12%;
      transform: rotate(45deg);
    }

    .deco-shape-2 {
      width: 40px;
      height: 40px;
      bottom: 20%;
      left: 8%;
      transform: rotate(20deg);
      border-color: rgba(0, 229, 255, .08);
      animation-delay: 2s;
    }

    .deco-shape-3 {
      width: 24px;
      height: 24px;
      top: 40%;
      left: 15%;
      transform: rotate(60deg);
      border-color: rgba(0, 180, 255, .06);
      animation-delay: 4s;
    }

    @keyframes deco-float {
      0%, 100% { opacity: .5; transform: rotate(45deg) translateY(0); }
      50% { opacity: 1; transform: rotate(45deg) translateY(-10px); }
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
      .login-header {
        padding: 16px 20px;
      }

      .logo-text {
        font-size: 1.1rem;
      }

      .back-link span {
        display: none;
      }

      .login-main {
        padding: 24px 16px;
      }

      .login-card {
        padding: 32px 24px;
        border-radius: 16px;
      }

      .login-title {
        font-size: 1.15rem;
      }

      .card-icon {
        width: 52px;
        height: 52px;
        margin-bottom: 20px;
      }

      .card-icon svg {
        width: 26px;
        height: 26px;
      }

      .deco-shape {
        display: none;
      }
    }

    /* ── Drupal admin toolbar compatibility ── */
    body.toolbar-fixed .login-header {
      /* Toolbar pushes content down, no extra fix needed */
    }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #080b12; }
    ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #00b4ff; }
  </style>
</head>

<body class="buildgear-login {{ body_classes }}">

  {# ── Background Effects ── #}
  <div class="bg-effects"></div>
  <div class="bg-grid"></div>

  {# ── Decorative Shapes ── #}
  <div class="deco-shape deco-shape-1"></div>
  <div class="deco-shape deco-shape-2"></div>
  <div class="deco-shape deco-shape-3"></div>

  {# ── Header ── #}
  <header class="login-header">
    <a href="{{ path('<front>') }}" class="logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24">
          <path d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
        </svg>
      </div>
      <span class="logo-text">
        <span class="white">Build</span><span class="cyan">Gear</span>
      </span>
    </a>

    <a href="{{ path('<front>') }}" class="back-link">
      <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span>Quay lại trang chủ</span>
    </a>
  </header>

  {# ── Main ── #}
  <main class="login-main">
    <div class="login-wrapper">

      {# Icon phía trên card #}
      <div class="card-icon">
        <svg viewBox="0 0 24 24">
          {# GPU / Chip icon #}
          <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
          <rect x="9" y="9" width="6" height="6"/>
          <line x1="9" y1="1" x2="9" y2="4"/>
          <line x1="15" y1="1" x2="15" y2="4"/>
          <line x1="9" y1="20" x2="9" y2="23"/>
          <line x1="15" y1="20" x2="15" y2="23"/>
          <line x1="20" y1="9" x2="23" y2="9"/>
          <line x1="20" y1="15" x2="23" y2="15"/>
          <line x1="1" y1="9" x2="4" y2="9"/>
          <line x1="1" y1="15" x2="4" y2="15"/>
        </svg>
      </div>

      {# Tiêu đề #}
      <h1 class="login-title">
        ĐĂNG NHẬP <span class="accent">BUILDGEAR</span>
      </h1>
      <p class="login-subtitle">
        Đăng nhập để quản lý tài khoản và trải nghiệm BuildGear
      </p>

      {# Login Card #}
      <div class="login-card">

        {# ── Drupal Messages (lỗi đăng nhập, thông báo...) ── #}
        {% if page.highlighted %}
          <div class="login-messages">
            {{ page.highlighted }}
          </div>
        {% endif %}

        {# ── Status messages ── #}
        {% if messages %}
          <div class="login-messages">
            {{ messages }}
          </div>
        {% endif %}

        {# ══════════════════════════════════════════════════════
           QUAN TRỌNG: Render form đăng nhập của Drupal
           ──────────────────────────────────────────────────────
           {{ page.content }} sẽ render toàn bộ form login
           bao gồm:
           - Input username
           - Input password
           - CSRF token (hidden field)
           - form_build_id (hidden field)
           - form_id (hidden field)
           - Nút submit
           
           KHÔNG TỰ TẠO FORM — để Drupal xử lý hoàn toàn.
           ══════════════════════════════════════════════════════ #}
        {{ page.content }}

        {# ── Extra Links ── #}
        <div class="login-extra-links">
          <a href="{{ path('user.pass') }}">Quên mật khẩu?</a>
          <div class="separator"></div>
          <span style="font-size: .82rem; color: #6b7280;">Chưa có tài khoản? </span>
          <a href="{{ path('user.register') }}" class="register-link">Đăng ký ngay</a>
        </div>
      </div>

    </div>
  </main>

  {# ── Footer ── #}
  <footer class="login-footer">
    © 2026 BuildGear - PC Components &amp; Performance
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // 1. Đổi nút submit LOG IN thành ĐĂNG NHẬP
      const submitButtons = document.querySelectorAll('.login-card input[type="submit"], .login-card button[type="submit"], #edit-submit');
      submitButtons.forEach(btn => {
        if (btn.tagName === 'INPUT') {
          btn.value = 'LOG IN';
        } else {
          btn.textContent = 'LOG IN';
        }
      });

      // 2. Việt hóa Label & Placeholder
      const nameLabel = document.querySelector('label[for="edit-name"]');
      if (nameLabel) nameLabel.textContent = 'TÊN ĐĂNG NHẬP';

      const passLabel = document.querySelector('label[for="edit-pass"]');
      if (passLabel) passLabel.textContent = 'MẬT KHẨU';

      const nameInput = document.getElementById('edit-name');
      if (nameInput) nameInput.placeholder = 'Nhập tên tài khoản...';

      const passInput = document.getElementById('edit-pass');
      if (passInput) passInput.placeholder = 'Nhập mật khẩu...';
    });
  </script>

  <js-bottom-placeholder token="{{ placeholder_token }}">
</body>
</html>
