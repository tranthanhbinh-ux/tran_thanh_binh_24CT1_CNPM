<!-- ═══════════════════════════════════ JAVASCRIPT ═══════════════════════════════════ -->
<script>
// ── Product Data & State ──
let products = [];
let compareList = [];
let cartCount = 0;
let currentCategory = 'all';
let searchTerm = '';

function addToCart(name) {
  cartCount++;
  const badge = document.getElementById('cartBadge');
  if (badge) {
    badge.textContent = cartCount;
    badge.classList.remove('scale-0');
    badge.classList.add('scale-100');
  }
}

// ── Hàm xử lý Live Search Dropdown (GearVN Dark Theme Style) ──
function escapeRegex(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function handleSearch(value, targetDropdownId = 'searchDropdown') {
  const query = value.trim();
  searchTerm = query;
  renderProducts();

  const dropdown = document.getElementById(targetDropdownId);
  if (!dropdown) return;

  if (!query) {
    dropdown.classList.add('hidden');
    dropdown.innerHTML = '';
    return;
  }

  // Lọc sản phẩm theo từ khóa
  const qLower = query.toLowerCase();
  const matched = products.filter(p => (p.name || '').toLowerCase().includes(qLower));
  const topResults = matched.slice(0, 5);

  dropdown.classList.remove('hidden');

  if (topResults.length === 0) {
    dropdown.innerHTML = `
      <div class="px-4 py-6 text-center text-sm text-gray-400">
        <p class="font-medium">Không tìm thấy sản phẩm nào</p>
        <p class="text-xs text-gray-500 mt-1">Thử tìm kiếm với từ khóa khác</p>
      </div>
    `;
    return;
  }

  // Regex để highlight từ khóa
  const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');

  const itemsHtml = topResults.map(p => {
    const highlightedName = p.name.replace(regex, '<span class="text-neon-blue font-bold">$1</span>');
    const imgContent = p.imageHtml && p.imageHtml.trim()
      ? p.imageHtml
      : `<svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>`;

    return `
      <a href="/drupal10/web/node/${p.nid}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-white/5 transition-colors group">
        <!-- Ảnh bên trái (nền trắng bo góc) -->
        <div class="w-12 h-12 rounded-xl bg-white p-1 shrink-0 flex items-center justify-center overflow-hidden img-drupal-fit border border-white/10">
          ${imgContent}
        </div>
        <!-- Thông tin bên phải -->
        <div class="flex-1 min-w-0">
          <h4 class="text-sm font-semibold text-white group-hover:text-neon-blue transition-colors line-clamp-2 leading-tight">
            ${highlightedName}
          </h4>
          <p class="text-xs font-bold text-red-500 mt-1">
            ${p.price}
          </p>
        </div>
      </a>
    `;
  }).join('');

  dropdown.innerHTML = `
    <!-- Header -->
    <div class="px-4 pt-3 pb-2 flex items-center justify-between border-b border-white/5">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Kết quả tìm kiếm</span>
      <span class="text-[11px] text-gray-500">${matched.length} sản phẩm</span>
    </div>
    
    <!-- List -->
    <div class="divide-y divide-white/5 max-h-[320px] overflow-y-auto">
      ${itemsHtml}
    </div>

    <!-- Footer -->
    <div class="border-t border-white/5 bg-surface-900/40">
      <a href="#products" onclick="document.querySelectorAll('#searchDropdown, #searchDropdownMobile').forEach(el => el.classList.add('hidden'))" class="block w-full py-2.5 px-4 text-center text-xs font-medium text-neon-blue hover:text-neon-cyan hover:bg-white/5 transition-colors">
        → Xem tất cả kết quả cho "${query}"
      </a>
    </div>
  `;
}

// ── Tự động ẩn Dropdown khi click bên ngoài (Click Outside) ──
document.addEventListener('click', function (e) {
  if (!e.target.closest('.search-container')) {
    document.querySelectorAll('#searchDropdown, #searchDropdownMobile').forEach(el => {
      el.classList.add('hidden');
    });
  }
});

// ── Hàm xử lý Lọc danh mục (Filter) ──
function setCategory(cat) {
  currentCategory = cat;

  // Cập nhật giao diện Active / Inactive cho các nút filter
  document.querySelectorAll('.filter-btn').forEach(btn => {
    const isCurrent = btn.dataset.cat === cat;
    if (isCurrent) {
      btn.className = 'filter-btn px-4 py-2 rounded-lg bg-neon-blue/10 border border-neon-blue/30 text-neon-blue text-xs font-semibold transition-all';
    } else {
      btn.className = 'filter-btn px-4 py-2 rounded-lg bg-white/5 border border-white/5 text-gray-400 text-xs font-medium hover:text-white hover:border-white/10 transition-all';
    }
  });

  renderProducts();
}

const catColors = {
  blue: { bg: 'bg-neon-blue/10', text: 'text-neon-blue', border: 'border-neon-blue/20' },
  red:  { bg: 'bg-neon-red/10', text: 'text-neon-red', border: 'border-neon-red/20' },
  cyan: { bg: 'bg-neon-cyan/10', text: 'text-neon-cyan', border: 'border-neon-cyan/20' },
  gold: { bg: 'bg-accent-gold/10', text: 'text-accent-gold', border: 'border-accent-gold/20' },
};

function extractText(str) {
  if (!str) return '';
  return String(str).replace(/<[^>]*>?/gm, '').trim();
}

function detectCategory(name) {
  const n = (name || '').toLowerCase();
  if (n.includes('rtx') || n.includes('gtx') || n.includes('rx') || n.includes('vga') || n.includes('gpu') || n.includes('card') || n.includes('geforce') || n.includes('radeon') || n.includes('graphics')) {
    return { category: 'VGA', color: 'red' };
  }
  if (n.includes('core') || n.includes('ryzen') || n.includes('cpu') || n.includes('i3') || n.includes('i5') || n.includes('i7') || n.includes('i9') || n.includes('threadripper') || n.includes('intel') || n.includes('amd') || n.includes('vi xử lý')) {
    return { category: 'CPU', color: 'blue' };
  }
  if (n.includes('ram') || n.includes('ddr4') || n.includes('ddr5') || n.includes('ddr') || n.includes('fury') || n.includes('vengeance') || n.includes('trident') || n.includes('kingston') || n.includes('corsair') || n.includes('g.skill')) {
    return { category: 'RAM', color: 'cyan' };
  }
  if (n.includes('main') || n.includes('bo mạch') || n.includes('b760') || n.includes('z790') || n.includes('b650') || n.includes('x670') || n.includes('motherboard') || n.includes('asus') || n.includes('msi') || n.includes('gigabyte')) {
    return { category: 'Mainboard', color: 'gold' };
  }
  return { category: 'Linh kiện', color: 'blue' };
}

// Hàm gọi dữ liệu từ Drupal API
async function loadDrupalData() {
  try {
    const res = await fetch('/drupal10/web/api/products?_format=json');
    const data = await res.json();
    
    if (Array.isArray(data)) {
      products = data.map((item, index) => {
        const title = extractText(item.title || item.title_1 || item.name || 'Linh kiện PC');
        const catInfo = detectCategory(title);
        const priceVal = Number(item.field_gia_ban) || 0;
        const benchVal = parseInt(item.field_benchmark) || 0;
        const formatPrice = priceVal > 0 ? priceVal.toLocaleString('vi-VN') + '₫' : 'Liên hệ';
        const formatBench = benchVal.toLocaleString('vi-VN');
        const rawImg = item.field_hinh_anh_san_pham || item.field_image || '';
        const nid = item.nid || (item.view_node ? item.view_node.split('/').pop() : index + 1);

        return {
          id: index + 1,
          nid: nid,
          name: title,
          price: formatPrice,
          category: catInfo.category, 
          categoryColor: catInfo.color,
          imageHtml: rawImg,
          benchmarks: { passmark: benchVal },
          benchmarkLabel: 'PassMark: ' + formatBench,
          specs: { 'Danh mục': catInfo.category, 'Trạng thái': 'Chính hãng 100%' }
        };
      });
    }
    
    renderProducts();
  } catch (error) {
    console.error("Lỗi kết nối API:", error);
  }
}

// ── Render Product Grid (có tích hợp Smart Search & Smart Filter) ──
function renderProducts() {
  const grid = document.getElementById('productGrid');
  if (!grid) return;

  // Lọc sản phẩm theo Search Term và Smart Category
  const filteredProducts = products.filter(p => {
    const nameLower = (p.name || '').toLowerCase();
    const searchLower = searchTerm.toLowerCase();

    // 1. Điều kiện tìm kiếm (theo tên hoặc danh mục)
    const matchesSearch = !searchLower || nameLower.includes(searchLower) || (p.category || '').toLowerCase().includes(searchLower);

    // 2. Điều kiện danh mục thông minh (Smart Category)
    let matchesCategory = true;
    if (currentCategory === 'CPU') {
      matchesCategory = p.category === 'CPU' || nameLower.includes('core') || nameLower.includes('ryzen') || nameLower.includes('cpu') || nameLower.includes('intel') || nameLower.includes('amd');
    } else if (currentCategory === 'VGA') {
      matchesCategory = p.category === 'VGA' || nameLower.includes('rtx') || nameLower.includes('gtx') || nameLower.includes('rx') || nameLower.includes('vga') || nameLower.includes('gpu') || nameLower.includes('card');
    } else if (currentCategory === 'RAM') {
      matchesCategory = p.category === 'RAM' || nameLower.includes('ram') || nameLower.includes('ddr') || nameLower.includes('fury') || nameLower.includes('corsair') || nameLower.includes('kingston');
    } else if (currentCategory !== 'all') {
      matchesCategory = (p.category || '').toLowerCase() === currentCategory.toLowerCase() || nameLower.includes(currentCategory.toLowerCase());
    }

    return matchesSearch && matchesCategory;
  });

  // Nếu không tìm thấy sản phẩm nào
  if (filteredProducts.length === 0) {
    grid.innerHTML = `<div class="col-span-full flex flex-col items-center justify-center py-20 text-gray-400">
      <svg class="w-12 h-12 text-gray-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
      </svg>
      <p class="text-base font-semibold text-gray-300">Không tìm thấy sản phẩm nào</p>
      <p class="text-xs text-gray-500 mt-1">Thử chọn danh mục khác hoặc xóa từ khóa tìm kiếm.</p>
    </div>`;
    return;
  }

  grid.innerHTML = filteredProducts.map(p => {
    const c = catColors[p.categoryColor] || catColors['blue'];
    const inCompare = compareList.includes(p.id);
    return `
      <div class="card-hover rounded-2xl bg-surface-700 border border-white/5 overflow-hidden flex flex-col">
        
        <!-- Link ảnh: Click vào là bay sang trang chi tiết -->
        <a href="/drupal10/web/node/${p.nid}" class="group relative block overflow-hidden rounded-t-2xl">
          <!-- Khung chứa ảnh -->
          <div class="w-full h-48 bg-surface-800 flex items-center justify-center relative overflow-hidden rounded-xl">
            <!-- Hiệu ứng Zoom khi Hover -->
            <div class="w-full h-full flex items-center justify-center img-drupal-fit transition-transform duration-500 ease-out group-hover:scale-105">
              ${p.imageHtml && p.imageHtml.trim() ? p.imageHtml : `
                <div class="flex flex-col items-center justify-center text-gray-500 gap-2">
                  <svg class="w-12 h-12 text-gray-600 group-hover:text-neon-blue transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
                  </svg>
                  <span class="text-[11px] font-medium text-gray-500">BuildGear Hardware</span>
                </div>
              `}
            </div>

            <!-- Huy hiệu danh mục (Góc trên bên trái) -->
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wider ${c.bg} ${c.text} border ${c.border}">
              ${p.category}
            </span>

            <!-- Huy hiệu Benchmark (Góc trên bên phải) -->
            <div class="absolute top-3 right-3 px-3 py-1.5 rounded-lg bg-black/60 backdrop-blur-md border border-neon-blue/30 shadow-neon-blue">
              <span class="text-[11px] font-bold text-neon-blue">⚡ ${p.benchmarkLabel}</span>
            </div>
          </div>
        </a>

        <!-- Body -->
        <div class="p-5 flex flex-col flex-1">
          
          <!-- Link tên sản phẩm: Click là bay sang trang chi tiết -->
          <a href="/drupal10/web/node/${p.nid}">
            <h3 class="text-sm font-bold text-white leading-snug mb-1 hover:text-neon-blue transition-colors">${p.name}</h3>
          </a>

          <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 mb-auto">
            ${Object.entries(p.specs).map(([k,v]) => `<span class="text-[11px] text-gray-500"><span class="text-gray-400">${k}:</span> ${v}</span>`).join('')}
          </div>

          <div class="mt-4 pt-4 border-t border-white/5">
            <div class="flex items-end justify-between mb-3">
              <p class="text-xl font-extrabold text-white">${p.price}</p>
            </div>

            <div class="flex gap-2">
              <button onclick="toggleCompare(${p.id})" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all duration-200 ${inCompare
                  ? 'bg-neon-blue/15 border border-neon-blue/40 text-neon-blue shadow-[0_0_12px_rgba(0,180,255,.15)]'
                  : 'bg-white/5 border border-white/10 text-gray-400 hover:text-neon-blue hover:border-neon-blue/30'}">
                <svg class="w-4 h-4" fill="${inCompare ? 'currentColor' : 'none'}" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  ${inCompare ? '<path d="M5 13l4 4L19 7"/>' : '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>'}
                </svg>
                ${inCompare ? 'Đã thêm' : 'So sánh'}
              </button>

              <button onclick="addToCart('${p.name}')" class="flex-1 flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-neon-blue text-white text-xs font-semibold hover:shadow-neon-blue transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
                Thêm vào giỏ
              </button>
            </div>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

// ── Compare Logic ──
function toggleCompare(id) {
  const idx = compareList.indexOf(id);
  if (idx > -1) {
    compareList.splice(idx, 1);
  } else {
    if (compareList.length >= 4) { alert('Tối đa 4 sản phẩm để so sánh.'); return; }
    compareList.push(id);
  }
  renderProducts();
  updateCompareUI();
}

function updateCompareUI() {
  const bar   = document.getElementById('compareBar');
  const badge = document.getElementById('compareBadge');
  const count = document.getElementById('compareCount');
  const preview = document.getElementById('comparePreview');

  badge.textContent = compareList.length;
  badge.classList.toggle('scale-0', compareList.length === 0);
  badge.classList.toggle('scale-100', compareList.length > 0);
  count.textContent = `Đã chọn ${compareList.length} sản phẩm`;

  if (compareList.length > 0) {
    bar.classList.remove('translate-y-full');
    bar.classList.add('translate-y-0');
  } else {
    bar.classList.add('translate-y-full');
    bar.classList.remove('translate-y-0');
  }

  // Preview chips
  preview.innerHTML = compareList.map(id => {
    const p = products.find(x => x.id === id);
    const c = catColors[p.categoryColor];
    return `<span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg ${c.bg} border ${c.border}">
      <span class="text-[11px] font-semibold ${c.text}">${p.name.split(' ').slice(-1)}</span>
      <button onclick="event.stopPropagation(); toggleCompare(${id})" class="text-gray-500 hover:text-white ml-0.5">×</button>
    </span>`;
  }).join('');
}

function clearCompare() {
  compareList = [];
  renderProducts();
  updateCompareUI();
}

function toggleCompareBar() {
  const bar = document.getElementById('compareBar');
  if (compareList.length === 0) return;
  bar.classList.toggle('translate-y-full');
  bar.classList.toggle('translate-y-0');
}

// ── Comparison Modal ──
function openCompareModal() {
  if (compareList.length < 2) { alert('Vui lòng chọn ít nhất 2 sản phẩm để so sánh.'); return; }
  const modal = document.getElementById('compareModal');
  modal.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  renderComparison();
}

function closeCompareModal() {
  document.getElementById('compareModal').classList.add('hidden');
  document.body.style.overflow = '';
}

function renderComparison() {
  const items = compareList.slice(0, 2).map(id => products.find(p => p.id === id));
  const [a, b] = items;

  // Determine benchmark keys to compare
  const allKeys = new Set([...Object.keys(a.benchmarks), ...Object.keys(b.benchmarks)]);
  const benchKeys = [...allKeys].filter(k => a.benchmarks[k] != null && b.benchmarks[k] != null);

  const benchLabels = {
    passmark: 'Điểm PassMark',
    timespy: '3DMark Time Spy',
    firestrike: '3DMark Fire Strike',
    cinebench_st: 'Cinebench (Đơn nhân)',
    cinebench_mt: 'Cinebench (Đa nhân)',
    readSpeed: 'Tốc độ đọc (MB/s)',
    writeSpeed: 'Tốc độ ghi (MB/s)',
  };

  // All spec keys
  const specKeys = [...new Set([...Object.keys(a.specs), ...Object.keys(b.specs)])];

  const body = document.getElementById('compareBody');
  body.innerHTML = `
    <!-- Product Headers -->
    <div class="grid grid-cols-[180px_1fr_1fr] gap-4 mb-8">
      <div></div>
      ${items.map(p => {
        const c = catColors[p.categoryColor];
        return `<div class="text-center">
          <img src="${p.image}" alt="${p.name}" class="w-full h-32 object-cover rounded-xl border border-white/5 mb-3" />
          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase ${c.bg} ${c.text} mb-2">${p.category}</span>
          <h4 class="text-sm font-bold text-white">${p.name}</h4>
          <p class="text-lg font-extrabold text-neon-blue mt-1">${p.price}</p>
        </div>`;
      }).join('')}
    </div>

    <!-- Benchmark Comparison -->
    ${benchKeys.length > 0 ? `
    <div class="mb-8">
      <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-neon-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Điểm Benchmark Hiệu Năng
      </h4>
      <div class="space-y-5">
        ${benchKeys.map(key => {
          const valA = a.benchmarks[key];
          const valB = b.benchmarks[key];
          const maxVal = Math.max(valA, valB);
          const pctA = (valA / maxVal * 100).toFixed(1);
          const pctB = (valB / maxVal * 100).toFixed(1);
          const winnerA = valA >= valB;
          const winnerB = valB >= valA;
          return `
            <div class="grid grid-cols-[180px_1fr_1fr] gap-4 items-center">
              <span class="text-xs font-semibold text-gray-300">${benchLabels[key] || key}</span>

              <!-- Product A bar -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold ${winnerA && valA !== valB ? 'text-neon-blue' : 'text-gray-400'}">${valA.toLocaleString('vi-VN')}</span>
                  ${winnerA && valA !== valB ? '<span class="text-[9px] font-bold text-neon-blue bg-neon-blue/10 px-1.5 py-0.5 rounded">THẮNG</span>' : ''}
                </div>
                <div class="h-3 rounded-full bg-surface-600 overflow-hidden">
                  <div class="progress-fill h-full rounded-full ${winnerA ? 'bg-gradient-to-r from-neon-blue to-neon-cyan' : 'bg-gray-600'}" style="width: 0%" data-width="${pctA}%"></div>
                </div>
              </div>

              <!-- Product B bar -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold ${winnerB && valA !== valB ? 'text-neon-red' : 'text-gray-400'}">${valB.toLocaleString('vi-VN')}</span>
                  ${winnerB && valA !== valB ? '<span class="text-[9px] font-bold text-neon-red bg-neon-red/10 px-1.5 py-0.5 rounded">THẮNG</span>' : ''}
                </div>
                <div class="h-3 rounded-full bg-surface-600 overflow-hidden">
                  <div class="progress-fill h-full rounded-full ${winnerB ? 'bg-gradient-to-r from-neon-red to-neon-pink' : 'bg-gray-600'}" style="width: 0%" data-width="${pctB}%"></div>
                </div>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    </div>
    ` : '<p class="text-sm text-gray-500 mb-6">Không có benchmark chung để so sánh cho các sản phẩm này.</p>'}

    <!-- Specs Table -->
    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Thông Số Kỹ Thuật
      </h4>
      <div class="rounded-xl border border-white/5 overflow-hidden">
        ${specKeys.map((key, i) => `
          <div class="grid grid-cols-[180px_1fr_1fr] gap-4 px-4 py-3 ${i % 2 === 0 ? 'bg-surface-700/50' : 'bg-surface-800/50'}">
            <span class="text-xs font-semibold text-gray-400">${key}</span>
            <span class="text-xs text-gray-200">${a.specs[key] || '—'}</span>
            <span class="text-xs text-gray-200">${b.specs[key] || '—'}</span>
          </div>
        `).join('')}
      </div>
    </div>
  `;

  // Animate progress bars
  setTimeout(() => {
    document.querySelectorAll('.progress-fill[data-width]').forEach(bar => {
      bar.style.width = bar.dataset.width;
    });
  }, 100);
}


// ── Navbar scroll effect ──
window.addEventListener('scroll', () => {
  document.getElementById('navbar').classList.toggle('navbar-scrolled', window.scrollY > 20);
});

// ── Init ──
renderProducts();
loadDrupalData();
</script>

</body>
</html>
