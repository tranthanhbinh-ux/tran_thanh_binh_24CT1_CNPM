<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BuildGearshop — Xây Dựng PC Trong Mơ Của Bạn</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            surface: { 900: '#0a0a0f', 800: '#12121a', 700: '#1a1a26', 600: '#222230'  },
            neon:    { blue: '#00b4ff', cyan: '#00e5ff', red: '#ff3c5f', pink: '#ff2d78' },
            accent:  { gold: '#fbbf24' },
          },
          boxShadow: {
            'neon-blue': '0 0 20px rgba(0,180,255,.35), 0 0 60px rgba(0,180,255,.10)',
            'neon-red':  '0 0 20px rgba(255,60,95,.35), 0 0 60px rgba(255,60,95,.10)',
            'card':      '0 4px 30px rgba(0,0,0,.45)',
          },
          keyframes: {
            'pulse-glow': {
              '0%, 100%': { boxShadow: '0 0 15px rgba(0,180,255,.30)' },
              '50%':      { boxShadow: '0 0 30px rgba(0,180,255,.55)' },
            },
            'slide-up': {
              '0%':   { transform: 'translateY(100%)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' },
            },
            'fade-in': {
              '0%':   { opacity: '0', transform: 'scale(.96)' },
              '100%': { opacity: '1', transform: 'scale(1)' },
            },
          },
          animation: {
            'pulse-glow': 'pulse-glow 2.5s ease-in-out infinite',
            'slide-up':   'slide-up .4s cubic-bezier(.22,1,.36,1)',
            'fade-in':    'fade-in .3s ease-out',
          },
        },
      },
    };
  </script>
  <style>
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #0a0a0f; }
    ::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #00b4ff; }

    /* Glow on hover for cards */
    .card-hover { transition: transform .25s, box-shadow .25s, border-color .25s; }
    .card-hover:hover { transform: translateY(-6px); box-shadow: 0 0 30px rgba(0,180,255,.18); border-color: rgba(0,180,255,.4); }

    /* Animated gradient border */
    .gradient-border {
      position: relative;
    }
    .gradient-border::before {
      content: '';
      position: absolute; inset: -1px; border-radius: inherit;
      background: linear-gradient(135deg, #00b4ff, #ff3c5f, #00e5ff);
      background-size: 300% 300%;
      animation: gradient-shift 4s ease infinite;
      z-index: -1;
      opacity: .7;
    }
    @keyframes gradient-shift {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Progress bar fill animation */
    .progress-fill { transition: width 1s cubic-bezier(.22,1,.36,1); }

    /* Navbar shrink on scroll */
    .navbar-scrolled { backdrop-filter: blur(20px); background: rgba(10,10,15,.92) !important; }

    /* Tooltip */
    [data-tooltip] {
      position: relative;
    }
    [data-tooltip]:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      top: 125%;
      left: 50%;
      transform: translateX(-50%);
      background: #1a1a26;
      color: #e5e7eb;
      font-size: 0.72rem;
      font-weight: 500;
      padding: 4px 10px;
      border-radius: 6px;
      white-space: nowrap;
      z-index: 60;
      border: 1px solid rgba(255,255,255,0.12);
      box-shadow: 0 4px 14px rgba(0,0,0,0.5);
      pointer-events: none;
    }

    /* Ép ảnh từ Drupal API vừa khít với khung thiết kế */
    .img-drupal-fit img { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
  </style>
</head>

<body class="bg-surface-900 text-gray-200 font-sans antialiased overflow-x-hidden">

<!-- ═══════════════════════════════════ HEADER / NAVBAR ═══════════════════════════════════ -->
<header id="navbar" class="fixed top-0 inset-x-0 z-50 transition-all duration-300 bg-surface-900/80 backdrop-blur-md border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">

      <!-- Logo -->
      <a href="#" class="flex items-center gap-2.5 shrink-0">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-neon-blue to-neon-cyan flex items-center justify-center shadow-neon-blue">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
          </svg>
        </div>
        <span class="text-xl font-extrabold tracking-tight">
          <span class="text-white">Build</span><span class="text-neon-blue">Gear</span><span class="text-gray-400 font-semibold">shop</span>
        </span>
      </a>

      <!-- Category Dropdown Button (GearVN Style) -->
      <div class="relative group hidden lg:block">
        <!-- Trigger Button -->
        <button type="button" class="flex items-center gap-2.5 px-4 py-2 rounded-xl bg-surface-800 border border-white/10 hover:border-neon-blue/40 text-sm font-bold text-white transition-all duration-200 focus:outline-none">
          <!-- Menu Icon (Default) -->
          <svg class="w-5 h-5 text-neon-blue group-hover:hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <!-- Close Icon (Hover) -->
          <svg class="w-5 h-5 text-neon-red hidden group-hover:block transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span>Danh mục</span>
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute top-full left-0 mt-3 w-72 bg-surface-800 border border-white/10 rounded-2xl shadow-2xl p-2 z-50 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-300">
          <div class="space-y-1">
            <!-- Item 1: Laptop -->
            <a href="#products" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3" />
                </svg>
                <span>Laptop & Phụ kiện</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 2: PC Gaming / PC Build -->
            <a href="#products" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                </svg>
                <span>PC Gaming / PC Đồ họa</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 3: CPU -->
            <a href="#products" onclick="setCategory('CPU')" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z" />
                </svg>
                <span>CPU - Bộ vi xử lý</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 4: VGA -->
            <a href="#products" onclick="setCategory('VGA')" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
                <span>VGA - Card màn hình</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 5: Mainboard -->
            <a href="#products" onclick="setCategory('Mainboard')" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-accent-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                </svg>
                <span>Mainboard - Bo mạch chủ</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 6: RAM - Ổ cứng -->
            <a href="#products" onclick="setCategory('RAM')" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                </svg>
                <span>RAM - Ổ cứng SSD</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 7: Màn hình -->
            <a href="#products" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125z" />
                </svg>
                <span>Màn hình máy tính</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <!-- Item 8: Bàn phím & Chuột -->
            <a href="#products" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-white/5 text-gray-200 hover:text-neon-blue transition-colors group/item text-sm font-medium">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neon-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" />
                </svg>
                <span>Bàn phím, Chuột & Gear</span>
              </div>
              <svg class="w-4 h-4 text-gray-500 group-hover/item:text-neon-blue group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Nav Links (desktop) -->
      <nav class="hidden lg:flex items-center gap-1">
        <a href="#products" onclick="setCategory('CPU')" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-neon-blue hover:bg-white/5 transition-colors">CPU</a>
        <a href="#products" onclick="setCategory('VGA')" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-neon-blue hover:bg-white/5 transition-colors">VGA</a>
        <a href="#products" onclick="setCategory('Mainboard')" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-neon-blue hover:bg-white/5 transition-colors">Mainboard</a>
        <a href="#products" onclick="setCategory('RAM')" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-neon-blue hover:bg-white/5 transition-colors">RAM</a>
      </nav>

      <!-- Search Bar -->
      <div class="hidden md:flex items-center flex-1 max-w-md mx-6 search-container">
        <div class="relative w-full group">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500 group-focus-within:text-neon-blue transition-colors z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" oninput="handleSearch(this.value, 'searchDropdown')" placeholder="Tìm kiếm GPU, CPU, điểm benchmark…" class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-surface-700 border border-white/5 text-sm text-gray-200 placeholder:text-gray-500 focus:outline-none focus:border-neon-blue/50 focus:ring-1 focus:ring-neon-blue/30 transition" />
          
          <!-- Live Search Dropdown -->
          <div id="searchDropdown" class="hidden absolute top-full left-0 w-full mt-2 z-[60] bg-surface-800 rounded-2xl border border-white/10 shadow-2xl overflow-hidden backdrop-blur-xl animate-fade-in">
            <!-- Rendered by JS -->
          </div>
        </div>
      </div>

      <!-- Right Icons -->
      <div class="flex items-center gap-2">
        <!-- Compare -->
        <button onclick="toggleCompareBar()" class="relative p-2.5 rounded-xl hover:bg-white/5 transition-colors group" data-tooltip="Danh sách so sánh">
          <svg class="w-5 h-5 text-gray-400 group-hover:text-neon-blue transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h4m-2-2v4m10 3h4m-2-2v4"/>
          </svg>
          <span id="compareBadge" class="absolute -top-0.5 -right-0.5 w-5 h-5 rounded-full bg-neon-red text-[10px] font-bold text-white flex items-center justify-center transition-transform scale-0">0</span>
        </button>
        <!-- Cart -->
        <a href="/drupal10/web/cart" class="relative p-2.5 rounded-xl hover:bg-white/5 transition-colors group inline-flex items-center justify-center cursor-pointer" data-tooltip="Giỏ hàng">
          <svg class="w-5 h-5 text-gray-400 group-hover:text-neon-blue transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
          </svg>
          <span id="cartBadge" class="absolute -top-0.5 -right-0.5 w-5 h-5 rounded-full bg-neon-blue text-[10px] font-bold text-white flex items-center justify-center transition-all duration-200 scale-0">0</span>
        </a>
        <!-- Đăng Nhập / Đăng Ký / Profile Dropdown (Desktop) -->
        <div class="hidden sm:flex items-center gap-2 ml-1">
          {% if logged_in %}
            <!-- Profile Dropdown (GearVN Style) -->
            <div class="relative group">
              <!-- Trigger Button -->
              <button class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-surface-800 border border-white/10 hover:border-neon-blue/40 text-sm font-medium text-gray-200 transition-all duration-200 focus:outline-none">
                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-neon-blue to-neon-cyan flex items-center justify-center text-white font-bold text-xs shadow-[0_0_10px_rgba(0,180,255,0.35)]">
                  {{ user.displayname|first|upper }}
                </div>
                <span class="max-w-[120px] truncate text-xs font-semibold text-gray-200 group-hover:text-neon-blue transition-colors">
                  {{ user.displayname }}
                </span>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-neon-blue transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </button>

              <!-- Dropdown Menu -->
              <div class="absolute right-0 top-full mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-gray-100 py-2 z-50 invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200">
