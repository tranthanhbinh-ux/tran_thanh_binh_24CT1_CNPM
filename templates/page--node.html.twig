<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>{{ head_title|default('Chi tiết sản phẩm | BuildGearshop') }}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { surface: { 900: '#0a0a0f', 800: '#12121a', 700: '#1a1a26' }, neon: { blue: '#00b4ff' } } } }
    };
  </script>
</head>
<body class="bg-surface-900 text-gray-200 font-sans min-h-screen flex flex-col">

  <!-- Header dùng chung -->
  <header class="py-4 bg-surface-900 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <a href="/drupal10/web/" class="text-xl font-extrabold text-white">Build<span class="text-neon-blue">Gear</span>shop</a>
      <a href="/drupal10/web/" class="text-sm text-gray-400 hover:text-white transition-colors">← Quay lại trang chủ</a>
    </div>
  </header>


  <main class="flex-1 w-full max-w-7xl mx-auto px-4 py-8">
    {{ page.content }}
  </main>

</body>
</html>