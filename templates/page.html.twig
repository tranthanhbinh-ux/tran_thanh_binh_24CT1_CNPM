<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BuildGearshop — Linh Kiện & PC Gaming</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            surface: { 900: '#0a0a0f', 800: '#12121a', 700: '#1a1a26', 600: '#222230' },
            neon:    { blue: '#00b4ff', cyan: '#00e5ff', red: '#ff3c5f', pink: '#ff2d78' },
          },
          boxShadow: {
            'neon-blue': '0 0 20px rgba(0,180,255,.35), 0 0 60px rgba(0,180,255,.10)',
          }
        },
      },
    };
  </script>
</head>

<body class="bg-surface-900 text-gray-200 font-sans min-h-screen flex flex-col antialiased">

  <!-- Header -->
  <header class="py-4 bg-surface-900/90 backdrop-blur-md border-b border-white/5 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <a href="/drupal10/web/" class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-neon-blue to-neon-cyan flex items-center justify-center shadow-neon-blue">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
          </svg>
        </div>
        <span class="text-xl font-extrabold tracking-tight">
          <span class="text-white">Build</span><span class="text-neon-blue">Gear</span><span class="text-gray-400 font-semibold">shop</span>
        </span>
      </a>

      <div class="flex items-center gap-6">
        <a href="/drupal10/web/" class="text-sm font-medium text-gray-400 hover:text-neon-blue transition-colors">Trang chủ</a>
        <a href="/drupal10/web/cart" class="text-sm font-medium text-gray-400 hover:text-neon-blue transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
          Giỏ hàng
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Chuẩn Full-width Dark Theme cho Trang Chi Tiết Sản Phẩm và Các Trang Khác -->
  <main class="flex-1 w-full py-8 bg-[#0a0a0f] text-gray-200">
    {# Khu vực hiển thị thông báo lỗi/thành công của Drupal #}
    {% if page.highlighted %}
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="bg-gray-800 border-l-4 border-yellow-500 text-yellow-300 p-4 rounded shadow-lg">
          {{ page.highlighted }}
        </div>
      </div>
    {% endif %}

    {{ page.content }}
  </main>

  <!-- Footer -->
  <footer class="py-6 bg-surface-900 border-t border-white/5 text-center text-xs text-gray-500">
    © 2026 BuildGearshop. Mọi quyền được bảo lưu.
  </footer>

</body>
</html>