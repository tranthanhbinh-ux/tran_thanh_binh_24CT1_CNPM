<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tài khoản | BuildGearshop</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { surface: { 900: '#0a0a0f', 800: '#12121a', 700: '#1a1a26' }, neon: { blue: '#00b4ff' } } } }
    };
  </script>
  <style>
    /* CSS "độ" form Drupal bằng Tailwind */
    main form {
      @apply flex flex-col gap-4;
    }
    
    main form label {
      @apply block text-sm font-semibold text-gray-300 mb-1;
    }

    /* Bo góc, đổi nền cho các ô nhập liệu */
    main form input[type="text"],
    main form input[type="password"],
    main form input[type="email"] {
      @apply w-full px-4 py-3 rounded-xl bg-surface-700 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors;
    }

    /* Làm cái nút Submit nổi bật lên */
    main form input[type="submit"] {
      @apply w-full py-3.5 mt-2 rounded-xl bg-neon-blue text-white font-bold cursor-pointer hover:shadow-[0_0_20px_rgba(0,180,255,0.4)] transition-all duration-300 hover:-translate-y-0.5;
    }

    /* Làm mờ các dòng ghi chú của Drupal */
    main form .description {
      @apply text-xs text-gray-500 mt-1;
    }

    /* Màu xanh cho các link (như Quên mật khẩu) */
    main form a {
      @apply text-neon-blue hover:underline text-sm font-medium;
    }
  </style>
</head>
<body class="bg-surface-900 text-gray-200 font-sans min-h-screen flex flex-col">

  <!-- Header đơn giản -->
  <header class="py-4 bg-surface-900 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <a href="/drupal10/web/" class="text-xl font-extrabold text-white">Build<span class="text-neon-blue">Gear</span>shop</a>
      <a href="/drupal10/web/" class="text-sm text-gray-400 hover:text-white transition-colors">← Quay lại trang chủ</a>
    </div>
  </header>

  <!-- Khung chứa Form -->
  <main class="flex-1 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-surface-800 p-8 rounded-2xl border border-white/10 shadow-2xl">
      <!-- Bơm nội dung form của Drupal vào đây -->
      {{ page.content }}
    </div>
  </main>

</body>
</html>