{#
/**
 * @file
 * Theme implementation for the Cart page (BuildGear Dark Gaming Theme).
 */
#}

<!-- Header -->
<header class="py-4 bg-surface-900/90 backdrop-blur-md border-b border-white/5 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
    <a href="/drupal10/web/" class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-neon-blue to-neon-cyan flex items-center justify-center shadow-neon-blue">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
        </svg>
      </div>
      <span class="text-xl font-extrabold tracking-tight">
        <span class="text-white">Build</span><span class="text-neon-blue">Gear</span><span class="text-gray-400 font-semibold">shop</span>
      </span>
    </a>

    <div class="flex items-center gap-6">
      <a href="/drupal10/web/" class="text-sm font-medium text-gray-400 hover:text-neon-blue transition-colors flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
        Tiếp tục mua hàng
      </a>
    </div>
  </div>
</header>

<!-- Main Content Giỏ Hàng -->
<main class="flex-1 max-w-7xl mx-auto px-4 py-12 w-full">
  {# Khu vực hiển thị thông báo lỗi/thành công của Drupal #}
  {% if page.highlighted %}
    <div class="mb-6">
      <div class="bg-gray-800 border-l-4 border-yellow-500 text-yellow-300 p-4 rounded-xl shadow-lg">
        {{ page.highlighted }}
      </div>
    </div>
  {% endif %}

  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
      <svg class="w-8 h-8 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
      </svg>
      Giỏ hàng của bạn
    </h1>
  </div>

  <!-- Cái hộp đen chứa giỏ hàng -->
  <div class="bg-surface-800 rounded-2xl p-6 md:p-8 shadow-2xl border border-white/5 cart-page-wrapper">
    {{ page.content }}
  </div>
</main>

<!-- Footer -->
<footer class="py-6 bg-surface-900 border-t border-white/5 text-center text-xs text-gray-500">
  © 2026 BuildGearshop. Mọi quyền được bảo lưu.
</footer>

<style>
  /* Styling Giỏ hàng BuildGear Dark Theme */
  .cart-page-wrapper .views-form {
    color: #e2e8f0;
  }

  .cart-page-wrapper .views-row {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 768px) {
    .cart-page-wrapper .views-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .cart-page-wrapper .views-field-purchased-entity img {
    max-width: 100px;
    max-height: 100px;
    object-fit: contain;
    border-radius: 0.5rem;
    background: #1a1a26;
    padding: 0.5rem;
  }

  .cart-page-wrapper .views-field-unit-price__number,
  .cart-page-wrapper .views-field-total-price__number {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ef4444;
  }

  /* Input số lượng */
  .cart-page-wrapper input[type="number"] {
    background-color: #1a1a26 !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    color: #fff !important;
    border-radius: 0.5rem;
    padding: 0.5rem;
    text-align: center;
    width: 5rem;
    font-weight: 600;
  }

  .cart-page-wrapper input[type="number"]:focus {
    outline: none;
    border-color: #00b4ff !important;
    box-shadow: 0 0 10px rgba(0, 180, 255, 0.4);
  }

  /* Nút Xóa (Remove) */
  .cart-page-wrapper input[name*="delete-order-item"],
  .cart-page-wrapper input[id*="remove-button"] {
    background-color: rgba(239, 68, 68, 0.1) !important;
    color: #f87171 !important;
    border: 1px solid rgba(239, 68, 68, 0.2) !important;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .cart-page-wrapper input[name*="delete-order-item"]:hover,
  .cart-page-wrapper input[id*="remove-button"]:hover {
    background-color: #ef4444 !important;
    color: #ffffff !important;
  }

  /* Form Actions (Cập nhật giỏ hàng & Thanh toán) */
  .cart-page-wrapper .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 2rem;
    align-items: center;
  }

  .cart-page-wrapper input[id*="edit-submit"] {
    background-color: #1a1a26 !important;
    color: #94a3b8 !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    padding: 0.875rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .cart-page-wrapper input[id*="edit-submit"]:hover {
    background-color: #222230 !important;
    color: #fff !important;
    border-color: rgba(255, 255, 255, 0.3) !important;
  }

  .cart-page-wrapper input[id*="edit-checkout"] {
    background: linear-gradient(135deg, #00b4ff, #0077b6) !important;
    color: #ffffff !important;
    padding: 0.875rem 2rem;
    border-radius: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 180, 255, 0.35);
    transition: all 0.2s;
    border: none !important;
  }

  .cart-page-wrapper input[id*="edit-checkout"]:hover {
    background: linear-gradient(135deg, #00c6ff, #0088cc) !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 25px rgba(0, 180, 255, 0.5);
  }

  /* Giỏ hàng trống */
  .cart-empty-page,
  .cart-page-wrapper .cart-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: #94a3b8;
    font-size: 1.125rem;
  }
</style>